# Google OAuth 2.0 Configuration
# Obtain credentials from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback

# Session Security & Encryption Secret
SESSION_SECRET=onboardpro_enterprise_session_secret_jwt_key_2026

# Application Configuration & Admin Access Whitelist (Comma-separated emails)
# Users with these emails signing in via Google or Local will be granted ADMIN role
ADMIN_EMAILS=admin@onboardpro.dev,alex.morgan@onboardpro.dev

# Server Port
PORT=5173
